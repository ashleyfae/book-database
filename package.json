{
  "name": "book-database",
  "title": "Book Database",
  "version": "1.4.2",
  "description": "Maintain a database of books and reviews.",
  "author": "Ashley Gibson",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "books",
    "wordpress",
    "wordpress-plugin"
  ],
  "homepage": "https://github.com/ashleyfae/book-database#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashleyfae/book-database.git"
  },
  "bugs": {
    "url": "https://github.com/ashleyfae/book-database/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.71.1"
  },
  "scripts": {
    "build:css": "sass assets/sass/admin.scss:assets/css/admin.css assets/sass/admin-blocks.scss:assets/css/admin-blocks.css assets/sass/admin-global.scss:assets/css/admin-global.css assets/sass/front-end.scss:assets/css/front-end.css --style=compressed --no-source-map --no-charset",
    "build:js": "esbuild assets/js/src/admin/book-graphs.js assets/js/src/admin/admin.js assets/js/src/admin/admin-global.js --bundle --minify --legal-comments=none --outdir=assets/js/build",
    "build:js:module": "esbuild assets/js/src/admin/amcharts-loader.js --bundle --minify --legal-comments=none --format=esm --splitting --outdir=assets/js/build",
    "build": "npm run build:css && npm run build:js && npm run build:js:module",
    "watch:css": "npm run build:css -- --watch",
    "watch:js": "npm run build:js -- --watch",
    "watch:js:module": "npm run build:js:module -- --watch",
    "dev": "npm run watch:css & npm run watch:js & npm run watch:js:module & wait"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.38",
    "flatpickr": "^4.6.13"
  }
}
